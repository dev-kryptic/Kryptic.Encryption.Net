<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PackageId>Kryptic.Encryption</PackageId>
        <Version>1.0.3</Version>
        <Authors>Kryptic by Theka.dev SINGLE MEMBER P.C.</Authors>
        <Copyright>Copyright (c) 2026 Kryptic by Theka.dev SINGLE MEMBER P.C.</Copyright>
        <Description>The open-source Kryptic encryption engine. All client-side cryptography for the Kryptic secrets platform: AES-256-GCM encryption, Argon2id key derivation, envelope construction and key wrapping. No custom primitives.</Description>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://kryptic.dev</PackageProjectUrl>
        <RepositoryUrl>https://github.com/dev-kryptic/Kryptic.Encryption</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>encryption;aes-gcm;argon2;secrets;kryptic</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Kryptic.Encryption.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
